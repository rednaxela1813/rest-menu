# Skopírujte do .env a upravte hodnoty.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=menu.local,192.168.1.50,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://menu.local,http://192.168.1.50

# --- Verejný prístup cez Cloudflare Tunnel (variant 2) -----------------------
# Pri verejnom prístupe pridajte svoju doménu do hostí aj CSRF a zapnite secure cookies:
#   DJANGO_ALLOWED_HOSTS=menu.vasa-restauracia.sk,192.168.1.50,localhost
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://menu.vasa-restauracia.sk
#   DJANGO_SECURE_COOKIES=True
#   PUBLIC_BASE_URL=https://menu.vasa-restauracia.sk
DJANGO_SECURE_COOKIES=False
# Token z Cloudflare Zero Trust (Networks → Tunnels → váš tunel → Install connector).
CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL
POSTGRES_DB=burger_menu
POSTGRES_USER=burger
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Channels
REDIS_URL=redis://redis:6379/0

# Prevádzka
DEFAULT_CURRENCY=EUR
GUEST_ORDER_RATE_LIMIT=10

# Adresa vkladaná do QR kódov. Musí byť dosiahnuteľná z telefónu hosťa.
# Lokálna sieť (telefón na Wi-Fi prevádzky): http://192.168.1.112:8000
# Produkcia za nginx:                        http://192.168.1.50
# Verejný prístup (mobilné dáta):            https://menu.mojarestauracia.sk
PUBLIC_BASE_URL=http://192.168.1.112:8000

# Zálohy
BACKUP_KEEP=14
